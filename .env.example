# VPN Configuration
# Gluetun supports 30+ providers: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Common providers: surfshark, nordvpn, private internet access, mullvad, protonvpn
VPN_SERVICE_PROVIDER=protonvpn

# VPN Type (wireguard or openvpn)
VPN_TYPE=openvpn

# VPN Credentials - varies by provider, see Gluetun wiki for your provider
OPENVPN_USER=
OPENVPN_PASSWORD=

# VPN Server Location
# Pick based on your needs:
#   - Closest to you = fastest speeds
#   - Specific country = access region-locked content (e.g., US for US Netflix)
# Examples: United Kingdom, United States, Netherlands, Switzerland
VPN_COUNTRIES=United Kingdom

# Media storage root path - adjust for YOUR NAS/server
# Examples:
#   /volume1/Media     (Ugreen, Synology)
#   /share/Media       (QNAP)
#   /srv/media         (Linux server)
MEDIA_ROOT=/volume1/Media
APP_ROOT=/volume2/docker/arr-stack


# Timezone - Set to YOUR timezone
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, America/Los_Angeles, Europe/Paris, Australia/Sydney
TZ=TZ=Europe/London

# User/Group IDs (usually 1000/1000, check with: id -u && id -g)
PUID=1000
PGID=10